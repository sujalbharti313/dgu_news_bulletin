# AI//CAMPUS backend configuration. Copy to backend/.env (git-ignored) and fill in real values locally,
# or set them in your hosting platform's secret settings. Never commit real values.

# development | test | staging | production
APP_ENV=development

# Supabase PostgreSQL connection string (dashboard: Connect). Pick ONE:
#   Direct (IPv6 only):     postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
#   Session pooler (IPv4):  postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
#   Transaction pooler:     postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres
# sslmode=require is added automatically for non-local hosts. URL-encode special characters in the password.
DATABASE_URL=

# Pool tuning. With the transaction pooler (port 6543) set DB_USE_NULL_POOL=true; prepared statements
# are disabled automatically on that port (override with DB_PREPARED_STATEMENTS=true|false).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_USE_NULL_POOL=false

# Comma-separated frontend origins allowed by CORS. No wildcards. Add the production frontend URL once known.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Serve is_demo (SAMPLE) records through the public API. Development only; rejected when APP_ENV=production.
EXPOSE_DEMO_CONTENT=true

# Requests per client IP per minute, per worker process. 0 disables.
RATE_LIMIT_PER_MINUTE=120

LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true

# --- Phase 3.1 ingestion (server-side only; never put these in the frontend) -----------------------------
# Feeds and newsletters to collect. Relative paths are resolved from backend/.
INGESTION_SOURCES_FILE=config/ingestion_sources.toml
# Bearer token for POST /api/v1/admin/ingestion/runs and GET /api/v1/admin/ingestion/status.
# Leave empty to disable those endpoints entirely (404). At least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INGESTION_ADMIN_TOKEN=
# Staged items are deleted automatically after this many days (1-90).
INGESTION_ITEM_RETENTION_DAYS=14
# Job bookkeeping rows are deleted after this many days, except each source's latest success.
INGESTION_JOB_RETENTION_DAYS=90
INGESTION_JOB_STALE_MINUTES=60
# Interval for `python -m scripts.ingest schedule` (15 minutes to 7 days).
INGESTION_SCHEDULE_MINUTES=360
INGESTION_HTTP_TIMEOUT_SECONDS=15
INGESTION_MAX_RESPONSE_BYTES=5000000
INGESTION_MAX_RETRIES=3
INGESTION_MAX_ITEMS_PER_SOURCE=100
INGESTION_USER_AGENT=AI-CAMPUS-Ingestion/0.3
# Route outbound fetches through HTTP(S)_PROXY. Keep false unless your host requires a proxy.
INGESTION_HTTP_TRUST_ENV=false

# Gmail API OAuth 2.0 (scope gmail.readonly) for the TLDR AI newsletter. All three or none.
# Get the refresh token once with: python -m scripts.gmail_oauth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Test suite only: a disposable LOCAL database whose name contains "test". Never a Supabase database.
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/aicampus_test

# --- Phase 3.2 processing and deduplication (optional; the defaults are documented in the README) ---
# PROCESSING_NEAR_DUPLICATE_TEXT_THRESHOLD=0.5
# PROCESSING_NEAR_DUPLICATE_TITLE_THRESHOLD=0.4
# PROCESSING_TITLE_ONLY_THRESHOLD=0.85
# PROCESSING_TITLE_ONLY_WINDOW_HOURS=48
# PROCESSING_NEAR_DUPLICATE_WINDOW_HOURS=168
# PROCESSING_STORY_THRESHOLD=0.3
# PROCESSING_STORY_WINDOW_HOURS=96
# PROCESSING_MIN_BODY_TOKENS=15
# PROCESSING_MAX_ITEMS=5000
