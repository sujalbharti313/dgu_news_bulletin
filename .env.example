# Base URL of the AI//CAMPUS FastAPI service (backend/). Leave unset to use the labelled sample adapter.
# Only this public URL belongs here: never database URLs, Supabase keys or other secrets.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public production URL, used for canonical and Open Graph URLs once known.
# NEXT_PUBLIC_SITE_URL=https://aicampus.example.edu

# Editorial admin sign-in (/admin), Supabase Auth. Both values are PUBLIC by design (Supabase dashboard:
# Project Settings -> API: Project URL and the "publishable" key, sb_publishable_...). Never put the secret or
# service_role key here. Leave unset to disable the admin pages.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
