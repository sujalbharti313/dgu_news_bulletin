# Base URL of the AI//CAMPUS FastAPI service (backend/). Leave unset to use the labelled sample adapter.
# Only this public URL belongs here: never database URLs, Supabase keys or other secrets.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public production URL, used for canonical and Open Graph URLs once known.
# NEXT_PUBLIC_SITE_URL=https://aicampus.example.edu
